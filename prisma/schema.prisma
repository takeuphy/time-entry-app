generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TimeEntry {
  id          Int      @id @default(autoincrement())
  clientName  String
  matterName  String
  date        String   // YYYY-MM-DD format for easy date filtering
  startTime   String   // HH:MM format
  endTime     String   // HH:MM format
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([createdAt])
}

model Setting {
  key   String @id
  value String
}

model CaseCode {
  id         Int      @id @default(autoincrement())
  code       String   @unique
  clientName String
  matterName String
  createdAt  DateTime @default(now())
}
